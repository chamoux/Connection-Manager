<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ConnectionManagerSetup</AssemblyName>
    <RootNamespace>ConnectionManager.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- One native exe and nothing next to it: it runs from Downloads, where no runtime file of ours can be trusted. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Runs elevated: ignore DOTNET_STARTUP_HOOKS, so an environment variable cannot load code into it. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The DLLs of the exe's static imports load from System32 only, never from the folder it runs from. -->
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>

  <!-- The release zip, embedded by tools\publish.ps1 (-p:PayloadZip=...). A build without it says so and exits 1. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="'$(PayloadZip)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConnectionManager.Setup.Tests" />
  </ItemGroup>

</Project>
